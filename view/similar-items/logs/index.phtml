<script>
  (function () {
    var form = document.getElementById('si-clear-form');
    if (!form) { return; }
    var before = document.getElementById('si-before');
    var after = document.getElementById('si-after');
    var beforeRange = document.getElementById('si-before-range');
    function toggle() {
      var mode = form.querySelector('input[name="mode"]:checked');
      var value = mode ? mode.value : 'now';
      before.disabled = (value !== 'before');
      after.disabled = (value !== 'range');
      beforeRange.disabled = (value !== 'range');
    }
    form.querySelectorAll('input[name="mode"]').forEach(function (r) {
      r.addEventListener('change', toggle);
    });
    toggle();
  })();
</script>

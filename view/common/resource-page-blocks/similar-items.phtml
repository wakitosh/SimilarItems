<?php
/**
 * Similar Items (module default view)
 *
 * Standalone default renderer so the module works without a theme override.
 * It renders a placeholder and fetches the recommendations from the module's
 * async endpoint, so that the configured scoring engine and the usage log are
 * used exactly as on a themed site.
 *
 * A theme providing the same partial path overrides this file entirely.
 */

$translate = $this->plugin('translate');
$escape = $this->plugin('escapeHtml');
$escapeAttr = $this->plugin('escapeHtmlAttr');

// Current Item/Resource.
$item = $this->vars()->offsetExists('item')
    ? $this->vars()->offsetGet('item')
    : ($this->vars()->offsetExists('resource') ? $this->vars()->offsetGet('resource') : null);
if (!$item || !method_exists($item, 'id')) {
    return;
}
$itemId = (int) $item->id();

// Site scope (if any). `currentSite` is a view helper, not a method, so it has
// to be called rather than probed with method_exists().
$site = null;
try {
    $site = $this->currentSite();
} catch (\Throwable $e) {
    $site = null;
}
if (!$site && $this->vars()->offsetExists('site')) {
    $site = $this->vars()->offsetGet('site');
}
$siteSlug = '';
try {
    if ($site && method_exists($site, 'slug')) {
        $siteSlug = (string) $site->slug();
    }
} catch (\Throwable $e) {
    $siteSlug = '';
}

// Prefer the site-aware endpoint so the site's theme (and any view override)
// applies when the partial is rendered server-side.
$endpointUrl = '';
try {
    if ($siteSlug !== '') {
        $endpointUrl = (string) $this->url('similaritems-recommend-site', ['site-slug' => $siteSlug]);
    }
} catch (\Throwable $e) {
    $endpointUrl = '';
}
if ($endpointUrl === '') {
    try {
        $endpointUrl = (string) $this->url('similaritems-recommend');
    } catch (\Throwable $e) {
        $endpointUrl = '/similar-items/recommend';
    }
}

// Number of results: theme setting when the theme provides one, otherwise the
// module setting.
$maxResults = 0;
try {
    $maxResults = (int) ($this->themeSetting('similar_items_max') ?: 0);
} catch (\Throwable $e) {
    $maxResults = 0;
}
if ($maxResults <= 0) {
    try {
        $maxResults = (int) ($this->setting('similaritems.limit') ?? 6);
    } catch (\Throwable $e) {
        $maxResults = 6;
    }
}
if ($maxResults <= 0) {
    $maxResults = 6;
}

$lang = '';
try {
    $lang = (string) $this->lang();
} catch (\Throwable $e) {
    $lang = '';
}
$isJa = (substr($lang, 0, 2) === 'ja');
$heading = $isJa ? '類似アイテム' : 'Similar items';
$loadingText = $isJa ? '検索しています…' : 'Searching…';
$emptyText = $isJa ? '該当するおすすめはありません。' : 'No recommendations found.';

// Default styling; a theme that only overrides CSS can simply restyle these
// classes. HeadLink skips the file when it is already registered.
$this->headLink()->appendStylesheet($this->assetUrl('css/similar-items.css', 'SimilarItems'));
?>
<div class="resource-block similar-items"
     data-similar-items
     data-item-id="<?php echo $itemId; ?>"
     data-limit="<?php echo (int) $maxResults; ?>"
     data-endpoint="<?php echo $escapeAttr($endpointUrl); ?>"
     data-site-slug="<?php echo $escapeAttr($siteSlug); ?>">
  <h3 class="block-title"><?php echo $escape($translate($heading)); ?></h3>
  <ul class="similar-items__list" id="similar-items-list-<?php echo $itemId; ?>">
    <li class="similar-items__loading" aria-live="polite" aria-busy="true">
      <span class="similar-items__spinner" aria-hidden="true"></span>
      <span class="similar-items__loading-text"><?php echo $escape($loadingText); ?></span>
    </li>
  </ul>
</div>

<script>
(function () {
  var root = document.querySelector('[data-similar-items][data-item-id="<?php echo $itemId; ?>"]');
  if (!root || root.dataset.similarItemsBound) { return; }
  root.dataset.similarItemsBound = '1';

  var listEl = document.getElementById('similar-items-list-<?php echo $itemId; ?>');
  var endpoint = root.getAttribute('data-endpoint');
  var id = root.getAttribute('data-item-id');
  var limit = root.getAttribute('data-limit');
  var site = root.getAttribute('data-site-slug') || '';
  var emptyText = <?php echo json_encode($emptyText, JSON_UNESCAPED_UNICODE); ?>;

  // Derive the site slug from the URL when the block was rendered outside a
  // site context (e.g. an unusual routing stack).
  if (!site && window.location && window.location.pathname) {
    var m = window.location.pathname.match(/\/s\/([^\/]+)/);
    if (m && m[1]) {
      site = decodeURIComponent(m[1]);
      root.setAttribute('data-site-slug', site);
    }
  }
  // Force the site-scoped endpoint when we know the slug, so the server can
  // apply the site's theme overrides while rendering the list.
  if (endpoint && site && endpoint.indexOf('/s/') === -1) {
    endpoint = '/s/' + encodeURIComponent(site) + '/similar-items/recommend';
    root.setAttribute('data-endpoint', endpoint);
  }

  var showEmpty = function () {
    if (listEl) {
      listEl.innerHTML = '<li class="similar-items__empty" aria-live="polite"></li>';
      listEl.firstChild.textContent = emptyText;
    }
  };

  var load = function () {
    var url = endpoint + '?id=' + encodeURIComponent(id)
      + '&limit=' + encodeURIComponent(limit)
      + (site ? '&site=' + encodeURIComponent(site) : '');
    fetch(url, { headers: { 'Accept': 'application/json' }, credentials: 'same-origin' })
      .then(function (r) { return r.ok ? r.json() : Promise.reject(); })
      .then(function (j) {
        if (!listEl) { return; }
        // The response carries the rendered <li> items, preceded by the hidden
        // usage-log payload when logging is enabled.
        listEl.innerHTML = (j && typeof j.html === 'string') ? j.html : '';
        if (!listEl.querySelector('li.resource')) { showEmpty(); }
      })
      .catch(showEmpty);
  };

  if (window.requestIdleCallback) {
    window.requestIdleCallback(load, { timeout: 1000 });
  } else {
    setTimeout(load, 0);
  }
})();
</script>

<?php
/**
 * Similar Items: sidebar list (module default view).
 *
 * Standalone default renderer so the module works without a theme override.
 * The list is fetched by similar-items-blocks.js, which serves every Similar
 * Items block on the page from one request, so that the configured scoring
 * engine and the usage log are used exactly as on a themed site.
 *
 * A theme providing the same partial path overrides this file entirely.
 */

include __DIR__ . '/_similar-items-context.php';
if ($itemId <= 0) {
    return;
}
$escape = $this->plugin('escapeHtml');
$escapeAttr = $this->plugin('escapeHtmlAttr');

// Default styling; a theme that only overrides CSS can simply restyle these
// classes. HeadLink skips the file when it is already registered.
$this->headLink()->appendStylesheet($this->assetUrl('css/similar-items.css', 'SimilarItems'));
?>
<div class="resource-block similar-items"
     data-similar-items
     data-si-placement="sidebar"
     data-si-empty-text="<?php echo $escapeAttr($emptyText); ?>"
     data-item-id="<?php echo $itemId; ?>"
     data-limit="<?php echo (int) $moduleLimit; ?>"
     data-endpoint="<?php echo $escapeAttr($endpointUrl); ?>"
     data-site-slug="<?php echo $escapeAttr($siteSlug); ?>">
  <h3 class="block-title"><?php echo $escape($heading); ?></h3>
  <ul class="similar-items__list" data-si-list aria-busy="true">
    <li class="similar-items__loading" aria-live="polite">
      <span class="similar-items__spinner" aria-hidden="true"></span>
      <span class="similar-items__loading-text"><?php echo $escape($loadingText); ?></span>
    </li>
  </ul>
</div>
